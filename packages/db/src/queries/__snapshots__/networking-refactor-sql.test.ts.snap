    UNION ALL SELECT profile_a_id FROM networking_connections WHERE event_id=$20 AND profile_b_id=$21
  ) and "networking_profiles"."sector" in ($22)) order by "networking_profiles"."first_name" asc, "networking_profiles"."last_name" asc, "networking_profiles"."id" asc limit $23 offset $24",
  },
  {
    "params": [
      1,
      "event",
      "viewer",
