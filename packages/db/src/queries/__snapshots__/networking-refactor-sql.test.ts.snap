exports[`keeps contact-export's distinct visibility and registration join scope 1`] = `
[
  {
    "params": [
      "viewer",
      "event",
      "viewer",
      "viewer",
      "viewer",
      "viewer",
      "viewer",
      "viewer",
      "event",
      "viewer",
      "viewer",
    ],
    "sql": "
    SELECT count(*)::int AS count FROM networking_connections c
    JOIN networking_messages m ON m.connection_id=c.id AND m.event_id=c.event_id
    JOIN networking_profiles p ON p.id=CASE WHEN c.profile_a_id=$1 THEN c.profile_b_id ELSE c.profile_a_id END AND p.event_id=c.event_id
    JOIN registrations r ON r.id=p.registration_id AND r.event_id=c.event_id
    JOIN networking_configs cfg ON cfg.event_id=c.event_id
    WHERE c.event_id=$2 AND (c.profile_a_id=$3 OR c.profile_b_id=$4)
      AND m.sender_id<>$5 AND (CASE WHEN c.profile_a_id=$6 THEN c.read_a_at ELSE c.read_b_at END IS NULL
        OR m.created_at>CASE WHEN c.profile_a_id=$7 THEN c.read_a_at ELSE c.read_b_at END)
      AND p.status='ACTIVE' AND p.consent AND p.withdrawn_at IS NULL AND r.networking_opt_in IS DISTINCT FROM false
      AND lower(p.email)<>(SELECT lower(email) FROM networking_profiles WHERE id=$8 AND event_id=$9)
      AND cfg.config->'eligiblePaymentStatuses' ? r.payment_status::text
      AND NOT EXISTS (SELECT 1 FROM networking_blocks b WHERE b.event_id=c.event_id
        AND ((b.profile_id=$10 AND b.target_id=p.id) OR (b.profile_id=p.id AND b.target_id=$11)))
  ",
  },
  {
    "params": [
      "viewer",
      "event",
      "event",
      "viewer",
      "viewer",
      "viewer",
      "viewer",
    ],
    "sql": "
    SELECT p.first_name AS "firstName",p.last_name AS "lastName",p.company,p.job_title AS "jobTitle",p.sector,p.city,p.country,p.website
    FROM networking_connections c JOIN networking_profiles p ON p.id=CASE WHEN c.profile_a_id=$1 THEN c.profile_b_id ELSE c.profile_a_id END
      JOIN registrations r ON r.id=p.registration_id JOIN networking_configs cfg ON cfg.event_id=c.event_id
    WHERE c.event_id=$2 AND p.event_id=$3 AND (c.profile_a_id=$4 OR c.profile_b_id=$5)
      AND p.status='ACTIVE' AND p.consent AND p.withdrawn_at IS NULL AND r.networking_opt_in IS DISTINCT FROM false
      AND cfg.config->'eligiblePaymentStatuses' ? r.payment_status::text
      AND NOT EXISTS (SELECT 1 FROM networking_blocks b WHERE b.event_id=c.event_id AND ((b.profile_id=$6 AND b.target_id=p.id) OR (b.profile_id=p.id AND b.target_id=$7)))
    ORDER BY p.last_name,p.first_name,p.id
  ",
  },
]
`;

