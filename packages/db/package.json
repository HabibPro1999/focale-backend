{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "@app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@app/source": "./src/testing/index.ts"
    },
    "./testing/fixtures": {
      "@app/source": "./tests/helpers/fixtures.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "test:migration": "vitest run --config vitest.migration.config.ts",
    "migrator": "node dist/migrator/cli.js",
    "networking:vector-index": "node dist/ops/networking-vector-index-cli.js",
    "cutover:preflight": "node dist/ops/cutover-preflight-cli.js"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
