# Focale backend development environment template.
# Copy to .env for local development and replace placeholders before running the app.
# Never commit real .env files or production secrets.

# Required core settings
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/focale_dev
CORS_ORIGIN=http://localhost:8080
# Reverse-proxy hops in front of the API whose X-Forwarded-For entries are trusted for the client IP
# (networking venue rate limits key on it). Required when NODE_ENV=production; unset = socket address.
# TRUST_PROXY=1
# Boot-time schema check against the migration ledger: enforce (refuse to start), warn (log), off.
# Default warn until the production ledger has been adopted (packages/db/src/migrator/README.md).
# MIGRATIONS_CHECK=warn

# Required Firebase settings when STORAGE_PROVIDER=firebase
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
# Optional Firebase service account JSON for deployed/cloud runtimes only.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"replace-with-project-id"}

# Email provider selection: sendgrid (default) or resend
# EMAIL_PROVIDER=sendgrid

# Shared sender identity (used by whichever provider is active).
# Falls back to SENDGRID_FROM_* below if unset.
# EMAIL_FROM_EMAIL=noreply@example.invalid
# EMAIL_FROM_NAME=Focale Events

# Optional SendGrid email delivery (used when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=replace-with-sendgrid-api-key
# SENDGRID_WEBHOOK_PUBLIC_KEY=replace-with-sendgrid-webhook-public-key
# SENDGRID_FROM_EMAIL=noreply@example.invalid
# SENDGRID_FROM_NAME=Focale Events

# Optional Resend email delivery (used when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_WEBHOOK_SECRET=whsec_replace-with-resend-webhook-signing-secret

# Storage provider: firebase or r2
STORAGE_PROVIDER=firebase

# Optional public forms base URL used in email links
# PUBLIC_FORMS_URL=https://forms.example.invalid

# Base URL for the admin app. Committee invite emails link to
# ${ADMIN_APP_URL}/committee/set-password. Legacy: the Firebase Console >
# Authentication > Templates > "Customize action URL" setting points at
# ${ADMIN_APP_URL}/auth/action for console-initiated password resets.
ADMIN_APP_URL=http://localhost:8080

# Required only when STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=replace-with-r2-account-id
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_BUCKET=replace-with-r2-bucket-name
# R2_PUBLIC_URL=https://assets.example.invalid

# Realtime / Server-Sent Events
REALTIME_DISABLED=false
SSE_HEARTBEAT_MS=25000
SSE_CLIENT_RETRY_MS=15000

# Public abstracts rate limits
ABSTRACTS_SUBMIT_RATE_LIMIT_MAX=60
ABSTRACTS_EDIT_RATE_LIMIT_MAX=30
ABSTRACTS_READ_RATE_LIMIT_MAX=120
ABSTRACTS_RATE_LIMIT_WINDOW=1 minute

# Committee invite links: how many days a single-use invite token stays valid
COMMITTEE_INVITE_TOKEN_TTL_DAYS=7

# Public Firebase web API key for certificate-fetch verification fallback.
# Override for deployments that use a different Firebase project.
# FIREBASE_WEB_API_KEY=your-project-web-api-key

# B2B Networking: configure before enabling the module for an event.
PUBLIC_NETWORKING_URL=http://localhost:8082
# Generate a secret with: openssl rand -hex 32
NETWORKING_TOKEN_SECRET=
# OpenAI-compatible embeddings endpoint; fixed 1536-dimensional storage.
NETWORKING_EMBEDDING_API_KEY=
NETWORKING_EMBEDDING_MODEL=text-embedding-3-small
NETWORKING_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Bounded worker throughput; tune to the provider's rate limits and DB capacity.
NETWORKING_EMBEDDING_BATCH_SIZE=16
NETWORKING_EMBEDDING_BATCHES_PER_TICK=8
NETWORKING_EMBEDDING_CONCURRENCY=2
# Generate once with web-push generateVAPIDKeys; keep the private key server-side.
NETWORKING_VAPID_PUBLIC_KEY=
NETWORKING_VAPID_PRIVATE_KEY=
NETWORKING_VAPID_SUBJECT=mailto:contact@focale.agency

# Optional server-owned networking sender map, keyed by client UUID.
# NETWORKING_EMAIL_SENDERS={"client-uuid":{"provider":"resend","email":"networking@events.example.invalid","domainId":"domain-id","name":"Organizer"}}
# Optional provider credentials with domain-read access for sender verification.
# RESEND_DOMAIN_READ_API_KEY=
# SENDGRID_DOMAIN_READ_API_KEY=
