# Focale backend environment template. GENERATED from the zod schema in
# packages/contracts/src/app-config.ts (.meta() on each key): do not edit by hand.
# Regenerate with `pnpm env:example`; CI fails on drift (`pnpm env:example --check`).
#
# Copy to .env for local development and replace placeholders before running the app.
# Never commit real .env files or production secrets. Blank values mean unset.
# Check a deployed environment against the production rules (prints failing key names
# only, never values): node packages/contracts/dist/cli/check-config.js

# --- Core ---
# development | production | test. The image sets production; production turns on the rules marked below.
NODE_ENV=development
# API HTTP port.
PORT=3000

# --- Database ---
# PostgreSQL/CockroachDB connection URL. Required.
# The pool pins TimeZone=UTC; `options`, `application_name` and timeout query
# parameters in the URL are replaced by the DB_* settings below.
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/focale_dev
# Pool size per process (1-100). Default 20 when NODE_ENV=production, 5 otherwise.
# DB_POOL_MAX=5
# Server-side statement timeout in ms (0 disables; otherwise 1000-3600000).
# DB_STATEMENT_TIMEOUT_MS=60000
# Idle-in-transaction session timeout in ms (0 disables).
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Statement timeout in ms for report/registration export fetches (0 disables).
# DB_EXPORT_STATEMENT_TIMEOUT_MS=300000
# Boot-time schema check against the migration ledger: enforce (refuse to start), warn (log), off.
# Default warn until the production ledger has been adopted (packages/db/src/migrator/README.md).
# MIGRATIONS_CHECK=warn

# --- HTTP ---
# Comma-separated browser origins allowed to call the API (scheme://host[:port], no path).
# `*` is accepted outside production only; production requires explicit origins.
CORS_ORIGIN=http://localhost:8080
# Comma-separated IP/CIDR addresses of trusted reverse-proxy peers. Forwarded client IP
# headers are ignored unless the connecting peer matches this list. Required in production;
# set TRUST_PROXY=false only when clients connect directly to the API with no proxy.
# Replace any old numeric hop-count setting with the actual proxy peer addresses from your
# deployment network configuration. Do not use true, *, or a /0 range.
# Example only; never copy these documentation/test addresses into production.
# TRUST_PROXY=10.0.0.0/24,2001:db8:1234::/48

# --- Public URLs ---
# Admin app base URL. Committee invite emails link to ${ADMIN_APP_URL}/committee/set-password.
# The Firebase Console action URL for password resets points at ${ADMIN_APP_URL}/auth/action.
# Production must set the deployed admin origin (the localhost default is rejected).
ADMIN_APP_URL=http://localhost:8080
# Public forms base URL for registration and abstract links in emails when a submission
# carries no link base. Required in production; defaults to http://localhost:8080 elsewhere.
# PUBLIC_FORMS_URL=https://forms.example.invalid
# Comma-separated exact HTTP(S) origins allowed as the link base stored with public
# registrations and abstracts. Required in production.
# PUBLIC_LINK_ALLOWED_ORIGINS=https://forms.example.invalid

# --- Firebase ---
# Firebase project (admin authentication). Required.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# Storage bucket. Required when STORAGE_PROVIDER=firebase.
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
# Service account JSON for deployed runtimes, raw or base64-encoded. When unset, the
# Admin SDK uses application default credentials (GOOGLE_APPLICATION_CREDENTIALS).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"replace-with-project-id"}
# Path to a service account file (application default credentials).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ID-token verification fallback (off by default). When the Admin SDK cannot fetch Google's
# x509 public keys (e.g. an egress block), admin sign-in fails unless this is enabled: the API
# then verifies tokens via identitytoolkit accounts:lookup and checks aud/iss/exp/sub/auth_time
# against FIREBASE_PROJECT_ID. Requires FIREBASE_WEB_API_KEY (boot fails without it); there is
# no built-in default. Successful lookups are cached for up to 5 minutes, so on this path a
# revoked token can stay accepted for up to 5 minutes.
# FIREBASE_AUTH_LOOKUP_FALLBACK=false
# Web API key of FIREBASE_PROJECT_ID; used only by the lookup fallback.
# FIREBASE_WEB_API_KEY=replace-with-project-web-api-key

# --- Storage ---
# firebase | r2.
STORAGE_PROVIDER=firebase
# Cloudflare R2 (every R2_* key is required when STORAGE_PROVIDER=r2).
# R2_ACCOUNT_ID=replace-with-r2-account-id
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_BUCKET=replace-with-r2-bucket-name
# R2_PUBLIC_URL=https://assets.example.invalid

# --- Email ---
# sendgrid | resend. Production requires the selected provider's API key and a sender.
# EMAIL_PROVIDER=sendgrid
# Shared sender identity for whichever provider is active (falls back to SENDGRID_FROM_*).
# EMAIL_FROM_EMAIL=noreply@example.invalid
# EMAIL_FROM_NAME=Focale Events
# SendGrid (EMAIL_PROVIDER=sendgrid). The API key is required in production.
# SENDGRID_API_KEY=replace-with-sendgrid-api-key
# SENDGRID_WEBHOOK_PUBLIC_KEY=replace-with-sendgrid-webhook-public-key
# SENDGRID_FROM_EMAIL=noreply@example.invalid
# SENDGRID_FROM_NAME=Focale Events
# Resend (EMAIL_PROVIDER=resend). The API key is required in production.
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_WEBHOOK_SECRET=whsec_replace-with-resend-webhook-signing-secret
# Optional provider credentials with domain-read access, used to verify networking senders
# (default: the provider's API key).
# SENDGRID_DOMAIN_READ_API_KEY=replace-with-sendgrid-domain-read-key
# RESEND_DOMAIN_READ_API_KEY=replace-with-resend-domain-read-key

# --- Realtime (Server-Sent Events) ---
# Disables the SSE outbox pump in the API. realtime.emit rows then accumulate; only disable
# where nothing produces them.
REALTIME_DISABLED=false
# SSE heartbeat interval in ms.
SSE_HEARTBEAT_MS=25000
# SSE client reconnect delay in ms.
SSE_CLIENT_RETRY_MS=15000

# --- Abstracts ---
# Public abstracts rate limits per IP and window (tunable for congress NAT/shared Wi-Fi).
ABSTRACTS_SUBMIT_RATE_LIMIT_MAX=60
ABSTRACTS_EDIT_RATE_LIMIT_MAX=30
ABSTRACTS_READ_RATE_LIMIT_MAX=120
# Window: milliseconds or "<n> <unit>" (ms, s, m/min/minute(s), h/hour(s)).
ABSTRACTS_RATE_LIMIT_WINDOW=1 minute
# Committee invite links: days a single-use invite token stays valid.
# COMMITTEE_INVITE_TOKEN_TTL_DAYS=7

# --- Certificates ---
# Certificate PDF font overrides (bundled fonts when unset).
# CERTIFICATE_FONT_PATH=/path/to/regular.ttf
# CERTIFICATE_BOLD_FONT_PATH=/path/to/bold.ttf

# --- B2B networking ---
# Set true only where no event uses networking: NETWORKING_TOKEN_SECRET is then not required
# and participant authentication returns 503.
# NETWORKING_DISABLED=false
# Networking PWA base URL (event links and push notification targets).
PUBLIC_NETWORKING_URL=http://localhost:8082
# Signs participant tokens and seals OTP codes (at least 32 characters); the keyring's `legacy` key.
# In production this or NETWORKING_KEYS is required unless NETWORKING_DISABLED=true. Generate with: openssl rand -hex 32
# NETWORKING_TOKEN_SECRET=replace-with-openssl-rand-hex-32-output
# Networking keyring: comma-separated kid:key entries (keys at least 32 characters), the first
# current; kid:key:recovery keeps a retired key only for existing recovery codes. See NETWORKING.md.
# NETWORKING_KEYS=k1:replace-with-openssl-rand-hex-32-output
# Write new networking MACs and seals as v1:<kid> with the first NETWORKING_KEYS key. Off keeps
# the legacy format while NETWORKING_TOKEN_SECRET is set (rollback-safe).
# NETWORKING_KEYRING_WRITE_V1=false
# OpenAI-compatible embeddings endpoint (fixed 1536-dimensional storage). Without a key
# (or OPENAI_API_KEY) recommendations skip embeddings.
# NETWORKING_EMBEDDING_API_KEY=replace-with-embeddings-api-key
# Fallback for NETWORKING_EMBEDDING_API_KEY.
# OPENAI_API_KEY=replace-with-openai-api-key
NETWORKING_EMBEDDING_MODEL=text-embedding-3-small
NETWORKING_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Bounded worker throughput; tune to the provider's rate limits and DB capacity.
NETWORKING_EMBEDDING_BATCH_SIZE=16
NETWORKING_EMBEDDING_BATCHES_PER_TICK=8
NETWORKING_EMBEDDING_CONCURRENCY=2
# Networking delivery worker: rows each general lane claims at a time, general lanes, and lanes that
# claim only sign-in codes (OTP), so a code never waits behind digests. See NETWORKING.md.
NETWORKING_DELIVERY_BATCH_SIZE=10
NETWORKING_DELIVERY_CONCURRENCY=6
NETWORKING_DELIVERY_OTP_LANES=2
# Networking emails per second per worker process (token bucket; sign-in codes go first). Keep it under
# the provider account's limit, leaving room for the other platform emails; a 429 pauses sending.
NETWORKING_EMAIL_RATE_PER_SECOND=5
# Days after a participant withdraws from networking before the worker erases the rest of their
# networking data (their profile content is scrubbed at once). See NETWORKING.md.
NETWORKING_WITHDRAWAL_ERASE_DAYS=30
# Web push. Generate once with web-push generateVAPIDKeys; keep the private key server-side.
# Push is off until all three are set.
# NETWORKING_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# NETWORKING_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# NETWORKING_VAPID_SUBJECT=mailto:contact@example.invalid
# Optional server-owned networking sender map (JSON object), keyed by client UUID.
# NETWORKING_EMAIL_SENDERS={"client-uuid":{"provider":"resend","email":"networking@events.example.invalid","domainId":"domain-id","name":"Organizer"}}

# --- Processes ---
# Which process the image CMD (start-runtime.mjs) supervises: api | worker | all (both in
# one container). Also selects the image HEALTHCHECK (API liveness or worker heartbeat).
# APP=api
# Worker kill switch: background jobs run unless this is the literal "false". With "false"
# the worker process idles with a disabled heartbeat, and APP=all starts only the API.
# RUN_WORKERS=true
# Graceful shutdown budget per process after SIGTERM (10000-290000 ms). The API drains SSE
# streams, closes HTTP, force-closes sockets 5 s before the end, then closes the pool; each
# process hard-exits at the limit and start-runtime.mjs SIGKILLs 3 s later. Keep it
# 3+ s below the platform's SIGKILL delay (Render maxShutdownDelaySeconds, 30 s).
# SHUTDOWN_GRACE_MS=25000
# Set by Render. Names this service in worker_heartbeats (/health/worker) and in migration
# ledger entries; defaults to focale-worker for the worker heartbeat.
# RENDER_SERVICE_NAME=focale-worker
# Worker heartbeat file, touched every 15 s together with the worker_heartbeats row (the
# image HEALTHCHECK fails a worker whose file is older than 60 s). Default: <os tmpdir>/focale-worker.heartbeat.
# WORKER_HEARTBEAT_FILE=/tmp/focale-worker.heartbeat
# fatal | error | warn | info | debug | trace | silent.
# LOG_LEVEL=info
