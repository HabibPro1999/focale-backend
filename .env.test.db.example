# Use as the shared environment template for disposable DB test tiers.
# Tests read process environment only; they never load .env files themselves.
# Never point it at a shared development, staging, or production database.

NODE_ENV=test
ALLOW_DB_TESTS=1

# Postgres-first default. Use the Cockroach example below only with a disposable
# CockroachDB 26.2.5 instance. The maintenance database name must itself include
# an exact `test` or `ci` token.
TEST_DB_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:5432/focale_test_admin

# Optional comma-separated exact host allowlist for remote disposable CI services.
# Loopback hosts are allowed without this setting.
TEST_DB_ALLOWED_HOSTS=

# CockroachDB local example (uncomment when needed):
# TEST_DB_ADMIN_URL=postgresql://root@127.0.0.1:26257/focale_test_admin?sslmode=disable
