{
  "name": "focale-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:runtime": "node --test scripts/start-runtime.test.mjs",
    "test:db": "pnpm -r --if-present test:db",
    "test:concurrency": "pnpm --filter @app/db test:concurrency",
    "test:migration": "pnpm --filter @app/db test:migration",
    "dev": "pnpm --filter @app/api dev",
    "dev:worker": "pnpm --filter @app/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.57.2"
  }
}
