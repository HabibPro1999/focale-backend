{
  "name": "focale-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:db": "pnpm --filter @app/db test:db",
    "test:concurrency": "pnpm --filter @app/db test:concurrency",
    "test:migration": "pnpm --filter @app/db test:migration",
    "dev": "pnpm --filter @app/api dev",
    "dev:worker": "pnpm --filter @app/worker dev"
  },
  "pnpm": {
    "overrides": {
      "@google-cloud/storage>fast-xml-parser": "5.10.1",
      "@nestjs/platform-fastify>fastify": "5.12.5",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "fast-uri": "3.1.8",
      "find-my-way": "9.9.0",
      "protobufjs": "7.6.5",
      "uuid@^8": "11.1.1",
      "uuid@^9": "11.1.1"
    }
  }
}
