{
  "name": "focale-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:runtime": "node --test scripts/start-runtime.test.mjs scripts/healthcheck.test.mjs scripts/eslint-package-boundaries.test.mjs scripts/eslint-write-executor.test.mjs scripts/swc-register.test.mjs",
    "env:example": "pnpm --filter @app/contracts build && node packages/contracts/dist/cli/env-example.js",
    "config:check": "node packages/contracts/dist/cli/check-config.js",
    "contracts:generate": "pnpm --filter @app/contracts build && node packages/contracts/dist/cli/contract-artifacts.js",
    "test:db": "pnpm -r --workspace-concurrency=1 --if-present test:db",
    "test:concurrency": "pnpm -r --workspace-concurrency=1 --if-present test:concurrency",
    "test:migration": "pnpm --filter @app/db test:migration",
    "dev": "pnpm --filter @app/api dev",
    "dev:worker": "pnpm --filter @app/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "^1.16.22",
    "eslint": "10.14.0",
    "pirates": "^4.0.7",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy": "3.2.3",
      "@google-cloud/storage>fast-xml-parser": "5.10.1",
      "@grpc/grpc-js": "1.14.6",
      "@nestjs/platform-fastify>fastify": "5.12.8",
      "axios": "1.20.0",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^2": "2.1.7",
      "fast-uri": "3.1.9",
      "find-my-way": "9.10.0",
      "follow-redirects": "1.16.2",
      "protobufjs": "7.6.5",
      "source-map-js": "1.2.2",
      "undici@^6": "6.29.1",
      "undici@^7": "7.30.1",
      "uuid@^8": "11.1.1",
      "uuid@^9": "11.1.1"
    }
  }
}
