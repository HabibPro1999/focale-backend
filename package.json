{
  "name": "focale-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:runtime": "node --test scripts/start-runtime.test.mjs scripts/healthcheck.test.mjs",
    "env:example": "pnpm --filter @app/contracts build && node packages/contracts/dist/cli/env-example.js",
    "config:check": "node packages/contracts/dist/cli/check-config.js",
    "test:db": "pnpm -r --workspace-concurrency=1 --if-present test:db",
    "test:concurrency": "pnpm --filter @app/db test:concurrency",
    "test:migration": "pnpm --filter @app/db test:migration",
    "dev": "pnpm --filter @app/api dev",
    "dev:worker": "pnpm --filter @app/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.57.2"
  },
  "pnpm": {
    "overrides": {
      "@google-cloud/storage>fast-xml-parser": "5.10.1",
      "@nestjs/platform-fastify>fastify": "5.12.5",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "fast-uri": "3.1.8",
      "find-my-way": "9.9.0",
      "protobufjs": "7.6.5",
      "uuid@^8": "11.1.1",
      "uuid@^9": "11.1.1"
    }
  }
}
