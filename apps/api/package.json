{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch --conditions=@app/source -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/db": "workspace:*",
    "@app/integrations": "workspace:*",
    "@app/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "exceljs": "4.4.0",
    "fastify": "^5.12.8",
    "file-type": "22.3.0",
    "jszip": "3.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
