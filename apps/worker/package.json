{
  "name": "@app/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch --conditions=@app/source -r ../../scripts/swc-register.cjs src/main.ts",
    "requeue-skipped-abstract-emails": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/requeue-skipped-abstract-emails.ts",
    "networking-keyring": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/networking-keyring.ts",
    "requeue-dead-letters": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/requeue-dead-letters.ts",
    "repair-sponsorship-code-usages": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/repair-sponsorship-code-usages.ts",
    "repair-paid-settlement": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/repair-paid-settlement.ts",
    "networking-retention": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/networking-retention.ts",
    "backfill-certificate-renders": "node --conditions=@app/source -r ../../scripts/swc-register.cjs src/scripts/backfill-certificate-renders.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/db": "workspace:*",
    "@app/integrations": "workspace:*",
    "@app/shared": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
